<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.KontaktPage"
             Title="KontaktPage">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
        <Label 
            Text="Kontakt ze mną"
            VerticalOptions="Center" 
            HorizontalOptions="Center"
            FontAttributes="Bold"
            FontSize="26"/>
            <Entry x:Name="EntryTytul" Placeholder="Podaj tytuł wiadomości" FontAttributes="Italic" FontSize="16"/>
            <Editor x:Name="WiadomoscEdytor" Placeholder="Twoja wiadomość" HeightRequest="120" FontAttributes="Italic" FontSize="16"/>
            <Button Text="Wyślij" Clicked="PoKliknieciuWyslij"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>