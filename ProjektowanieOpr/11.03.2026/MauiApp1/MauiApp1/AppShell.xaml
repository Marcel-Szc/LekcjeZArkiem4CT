<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="MauiApp1.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:MauiApp1"
    Title="MauiApp1">

    <FlyoutItem 
        Title="O nas">
        <ShellContent
            ContentTemplate="{DataTemplate local:ONasPage}"
        />
    </FlyoutItem>
    
    <FlyoutItem 
     Title="Galeria">
        <ShellContent
         ContentTemplate="{DataTemplate local:GaleriaPage}"
    />
    </FlyoutItem>
    
    <FlyoutItem 
     Title="Kontakt">
        <ShellContent
        ContentTemplate="{DataTemplate local:KontaktPage}"
    />
    </FlyoutItem>
</Shell>
