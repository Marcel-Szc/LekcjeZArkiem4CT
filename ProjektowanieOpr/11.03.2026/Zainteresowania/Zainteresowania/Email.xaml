<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Zainteresowania.Email"
             Title="Email">
    <VerticalStackLayout>
        <Entry 
            x:Name="TytulEntry"
            Placeholder="Tytut"/>
        <Editor 
            x:Name="WiadomoscEditor"
            Placeholder="Twoja wiadomość"
            HeightRequest="120"/>
        <Button 
            Text="Wyślij"
            Clicked="OnSendClicked"/>
    </VerticalStackLayout>
</ContentPage>