<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp2.KontaktPage"
             Title="KontaktPage">
    <VerticalStackLayout Padding="25" Spacing="15">
        <Label 
            Text="Skontaktuj się ze mną"
            FontSize="22"
            FontAttributes="Bold"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Frame CornerRadius="12" Padding="10">
            <Entry x:Name="TitleEntry" Placeholder="Tytuł wiadomości"/>
        </Frame>
        <Frame CornerRadius="12" Padding="10">
            <Editor x:Name="MessageEditor" Placeholder="Treść wiadomości" HeightRequest="120"/>
        </Frame>
        <Button BackgroundColor="Blue" Text="Wyślij" Clicked="OnClick_Send"/>
    </VerticalStackLayout>
</ContentPage>