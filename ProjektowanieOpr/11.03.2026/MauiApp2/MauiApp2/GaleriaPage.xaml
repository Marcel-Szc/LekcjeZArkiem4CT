<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp2.GaleriaPage"
             Title="GaleriaPage">
    <VerticalStackLayout Padding="20">
        <Label 
            Text="Galeria .NET MAUI"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Image x:Name="MainImage" Source="photo.jpg" HeightRequest="250" HorizontalOptions="Center"/>
        <Button Text="POWIEKSZ CHOPIE FOTO" Clicked="OnZoom_Clicked"/>
    </VerticalStackLayout>
</ContentPage>