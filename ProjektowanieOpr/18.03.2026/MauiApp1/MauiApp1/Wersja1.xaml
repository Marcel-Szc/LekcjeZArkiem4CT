<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Wersja1"
             Title="Wersja1">
    <VerticalStackLayout 
        Padding="30" 
        Spacing="20">
        <Button 
            Text="Pokaż pogodę" 
            Clicked="GetWeather"/>
        <Label
            x:Name="WeatherLabel" 
            Text="Klikinij przycisk aby zobaczyć pogodę"
            FontSize="18"/>
    </VerticalStackLayout>
</ContentPage>