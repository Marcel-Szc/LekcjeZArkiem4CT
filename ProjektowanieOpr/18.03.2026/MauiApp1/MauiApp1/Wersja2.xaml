<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp1.Wersja2"
             Title="Wersja2">
    <VerticalStackLayout>
        <Label 
            Text="Wybierz miasto: "
            FontSize="18" 
            HorizontalOptions="Center" />
        <Picker x:Name="CityPicker"
                Title="Miasto">
            <Picker.Items>
                <x:String>Pszczyna</x:String>
                <x:String>Warszawa</x:String>
                <x:String>Kraków</x:String>
                <x:String>Gdańsk</x:String>
            </Picker.Items>
        </Picker>
        <Button Text="Pokaż pogodę"
                Clicked="GetWeather"/>
        <Label x:Name="WeatherLabel"
               FontSize="18"
               Text="Wybierz miasto i kliknij przycisk"/>
    </VerticalStackLayout>
</ContentPage>