<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp5.MainPage">

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20">
            <Entry x:Name="A" Placeholder="Liczba A" Keyboard="Numeric"/>
            <Entry x:Name="B" Placeholder="Liczba B" Keyboard="Numeric"/>
            <Button Text="+" Clicked="Add"/>
            <Button Text="-" Clicked="Sub"/>
            <Button Text="*" Clicked="Mul"/>
            <Button Text="/" Clicked="Div"/>
            <Label x:Name="Result"/>
        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
