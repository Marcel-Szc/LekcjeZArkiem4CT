<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiApp6.MainPage">

    <ScrollView>
        <VerticalStackLayout
            BackgroundColor="White"
            Padding="30,0"
            Spacing="25">
            

            <Label
                Text="Kalkulator BMI"
                FontSize="40"
                FontAttributes="Bold"
                TextColor="Black"
                HorizontalOptions="Center"
            />
            <Label 
                Text="Wzrost(cm)"
                FontSize="15"
                TextColor="Black"
            />
            <Entry 
                x:Name="Wzrost"
                Keyboard="Numeric"
                TextColor="Black"
                Placeholder="np. 175"
            />
            <Label 
                Text="Waga(kg)"
                FontSize="15"
                TextColor="Black"
            />
            <Entry 
                x:Name="Waga"
                Keyboard="Numeric"
                TextColor="Black"
                Placeholder="np. 80"
            />
            <Button
                Text="Oblicz BMI"
                BackgroundColor="Blue"
                Clicked="ButtonOblicz"
            />
            <Label 
                Text=""
                x:Name="Result"
                TextColor="Black"
                FontSize="20"
                HorizontalOptions="Center"
            />
            <Label 
                Text=""
                x:Name="Wynik"
                TextColor="Black"
                FontSize="20"
                HorizontalOptions="Center"
            />
            <BoxView 
                HeightRequest="5"
            />
            <Label 
                Text="Prawidłowe BMI to 18,5–24,9"
                TextColor="Gray"
                HorizontalOptions="Center"
            />
        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
