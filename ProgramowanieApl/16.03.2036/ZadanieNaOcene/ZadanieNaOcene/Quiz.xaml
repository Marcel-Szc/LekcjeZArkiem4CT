<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ZadanieNaOcene.Quiz"
             Title="Quiz">
    <VerticalStackLayout
        Padding="20"
        Spacing="15">
        <Label 
            x:Name="QuestionLabel" Text="Pytanie" FontAttributes="Bold" FontSize="18" />
        <RadioButton x:Name="Option1" GroupName="Answer" Content="Opcja 1"/>
        <RadioButton x:Name="Option2" GroupName="Answer" Content="Opcja 1"/>
        <Button x:Name="NextButton" Text="Nastęne" Clicked="OnNextClicked"/>
        <Label x:Name="ResultLabel" FontAttributes="Bold" TextColor="Green"/>
    </VerticalStackLayout>
</ContentPage>