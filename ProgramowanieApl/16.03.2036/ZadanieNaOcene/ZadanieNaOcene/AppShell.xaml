<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ZadanieNaOcene.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:ZadanieNaOcene"
    Title="ZadanieNaOcene">

    <FlyoutItem Title="O mnie">
        <ShellContent ContentTemplate="{DataTemplate local:OMnie}"/>
    </FlyoutItem>
    <FlyoutItem Title="Zainteresowania">
        <ShellContent ContentTemplate="{DataTemplate local:Zainteresowania}"/>
    </FlyoutItem>
    <FlyoutItem Title="Galeria">
        <ShellContent ContentTemplate="{DataTemplate local:Galeria}"/>
    </FlyoutItem>
    <FlyoutItem Title="Quiz">
        <ShellContent ContentTemplate="{DataTemplate local:Quiz}"/>
    </FlyoutItem>

</Shell>
